# Copy this file to `.env` and fill in real values. Never commit `.env`.

# PostgreSQL connection string
DATABASE_URL=postgresql+psycopg2://user:password@host/dbname?sslmode=require

# JWT signing key — use a long random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-to-a-long-random-string

# Google Gemini (course generation, QCM, recaps, embeddings)
gemini_api_key=

# Pinecone (RAG vector store)
Pinecone_api_key=
PINECONE_INDEX=hub4learners

# Stripe (payments) — omit to run without payment features
Stripe_secret_key=
Stripe_publishable_key=
